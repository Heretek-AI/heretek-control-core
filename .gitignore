# Composer: ignore everything under vendor/, then un-ignore ONLY the runtime
# packages we ship (the MCP adapter + the Jetpack Autoloader). Dev tooling
# (phpunit, sebastian, nikic, …) stays ignored and is restored by
# `composer install`. We load vendor/autoload_packages.php at runtime, never
# vendor/autoload.php, so the standard composer autoload_*.php are NOT shipped.
/vendor/*
!/vendor/autoload_packages.php
!/vendor/automattic/
!/vendor/jetpack-autoloader/
!/vendor/wordpress/
!/vendor/enshrined/
!/vendor/composer/
/vendor/composer/*
!/vendor/composer/InstalledVersions.php
!/vendor/composer/installed.json
!/vendor/composer/LICENSE
!/vendor/composer/jetpack_autoload_classmap.php
!/vendor/composer/jetpack_autoload_filemap.php
!/vendor/composer/jetpack_autoload_psr4.php

# Within the shipped packages, keep runtime code only — drop test/CI/doc cruft
# so the zip stays lean (composer install restores them locally; they're just
# never tracked or shipped).
/vendor/wordpress/mcp-adapter/tests/
/vendor/wordpress/mcp-adapter/docs/
/vendor/wordpress/mcp-adapter/.github/
/vendor/wordpress/mcp-adapter/*.dist
/vendor/wordpress/mcp-adapter/phpstan.neon*
/vendor/wordpress/mcp-adapter/phpcs.xml*
/vendor/wordpress/mcp-adapter/.wordpress-org/
/vendor/wordpress/mcp-adapter/bin/
/vendor/wordpress/php-mcp-schema/docs/
/vendor/wordpress/php-mcp-schema/resources/
/vendor/wordpress/php-mcp-schema/tests/
/vendor/wordpress/php-mcp-schema/generator/
/vendor/wordpress/php-mcp-schema/.github/
/vendor/wordpress/php-mcp-schema/*.dist
/vendor/wordpress/php-mcp-schema/phpstan.neon*
/vendor/automattic/jetpack-autoloader/tests/
/vendor/automattic/jetpack-autoloader/.github/
/vendor/automattic/jetpack-autoloader/*.dist

# Non-runtime metadata inside the shipped packages — lockfiles, package
# manifests, markdown docs, skill guides. Never loaded at runtime; they only
# bloat the zip (a 752K Node package-lock.json was the worst offender). LICENSE*
# is deliberately KEPT for redistribution compliance.
/vendor/**/package-lock.json
/vendor/**/package.json
/vendor/**/composer.lock
/vendor/**/.npmrc
/vendor/**/README*.md
/vendor/**/README-INITIAL.md
/vendor/**/CONTRIBUTING*.md
/vendor/**/SECURITY*.md
/vendor/**/CHANGELOG*.md
/vendor/**/CLAUDE.md
/vendor/**/AGENTS.md
/vendor/**/.wp-env*.json
/vendor/wordpress/mcp-adapter/readme.txt
/vendor/wordpress/php-mcp-schema/skill/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# PHPUnit cache
.phpunit.cache/
.phpunit.result.cache

# Claude Code local settings
.claude/settings.local.json
.claude/settings.json
.claude/skills/

#Tests
releases/*
#Security
.mcp.json

#Meta
# Local working docs (superpowers specs/plans, design notes) remain ignored.
# Release-facing integration guides are the only public files under docs/.
/docs/*
!/docs/ACF-MCP-COVERAGE.md
!/docs/BRICKS-INTEGRATION.md
!/docs/BREAKDANCE-INTEGRATION.md
!/docs/AVADA-INTEGRATION.md
!/docs/FLATSOME-INTEGRATION.md
!/docs/DIVI-INTEGRATION.md
!/docs/THRIVE-INTEGRATION.md
!/docs/OXYGEN-INTEGRATION.md
!/docs/KIRKI-INTEGRATION.md
!/docs/GSAP-INTEGRATION.md
.commandcode/

# Fork: All Pro files are unlocked and tracked directly in the repo.
mitm_mcp_traffic.db
/review/

# Public test-suite cache (tests/phpunit.xml)
.phpunit.public.cache/

# Playwright MCP + local test artifacts (never committed)
.playwright-mcp/
/scripts/e2e/.breakdance-*.json
/services-final.png
/services-page.png

# Freemius deploy secrets — NEVER commit. The API Bearer token / secret key go
# in .freemius.env (gitignored); pro/tools/freemius-deploy.sh auto-loads it.
# Only .freemius.env.example (no real values) is tracked.
.freemius.env
.freemius.env.local
freemius.env

# Internal security audit working documents. These contain reproducing
# exploits for released versions, so they must never reach the public repo.
SECURITY-REMEDIATION-*.md
PRODUCTION-SECURITY-HANDOVER-*.md

# Release distribution builds
dist/

# Local Oxygen MCP verification artifacts
/.oxygen-*.json
/scripts/e2e/.oxygen-*.json
/scripts/e2e/__pycache__/
/scripts/e2e/.kirki-state.json

!docs/WPBAKERY-INTEGRATION.md
scripts/e2e/.wpbakery-state.json

!docs/BEAVER-INTEGRATION.md
scripts/e2e/.beaver-state.json

!docs/BLOCKSY-INTEGRATION.md
!docs/VISUAL-COMPOSER-INTEGRATION.md
/scripts/e2e/visual-composer-*.json
/scripts/e2e/visual-composer-*.txt
scripts/e2e/otter-*.json
!docs/OTTER-INTEGRATION.md
!docs/RELEASE-3.17.0.md
!docs/qa/

# JavaScript build tooling (admin redesign)
/node_modules/
/test-results/
/playwright-report/
/.playwright-mcp/
# Playwright auth cookies (live admin session; never commit)
/tests-e2e/.auth/
