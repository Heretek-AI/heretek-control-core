*.sh text eol=lf
readme.txt text eol=lf
assets/admin/build/** linguist-generated=true -diff
includes/admin/icons.php linguist-generated=true -diff
package-lock.json -diff
# Build output is written with LF; pin it so a checkout matches a fresh build
# and the release staleness check (git status) stays clean on Windows.
assets/admin/build/*.js text eol=lf
assets/admin/build/*.css text eol=lf
assets/admin/build/*.php text eol=lf
includes/admin/icons.php text eol=lf
assets/admin/build/fonts/** binary
# Admin UI sources: prettier (wp-scripts lint) requires LF.
admin-src/** text eol=lf
admin-build/** text eol=lf
*.config.js text eol=lf
eslint.config.cjs text eol=lf
tests-e2e/** text eol=lf

# Exclude developer, test, documentation, and CI files from release zip archives
.git export-ignore
.github export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.claude export-ignore
tests export-ignore
phpunit.xml export-ignore
phpunit.xml.dist export-ignore
composer.json export-ignore
composer.lock export-ignore
CLAUDE.md export-ignore
bin/smoke-free-build.sh export-ignore
bin/mcp-proxy.test.mjs export-ignore
bin/release.test.mjs export-ignore
